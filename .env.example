# DIU GreenGrid Environment Template
# ===============================================

# 1. Database Connection URL:
# Option A (Default local development - SQLite):
DATABASE_URL="file:./dev.db"

# Option B (Production / Staging - PostgreSQL):
# 1) Set provider = "postgresql" in prisma/schema.prisma
# 2) Uncomment and configure the PostgreSQL connection string below:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/diu_greengrid?schema=public"

# 2. Security & Auth Secrets:
JWT_SECRET="replace-with-a-robust-secret-key"
NODE_ENV="development"

# 3. Public Metadata:
NEXT_PUBLIC_APP_NAME="DIU GreenGrid"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_CAMPUS="Daffodil International University - Ashulia Smart Campus"
