// Prisma Schema for DIU GreenGrid
// Software-First Smart Campus Energy & Sustainability Monitoring System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User & Role-Based Access Control
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("AUDITOR_VIEWER") // "ADMIN", "FACILITY_MANAGER", "AUDITOR_VIEWER"
  department   String   @default("Campus Facilities")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Campus Building Entity
model Building {
  id                  String   @id @default(uuid())
  code                String   @unique // e.g. "AB-01", "AB-02", "YK-SG", "LIB", "ADMIN"
  name                String   // e.g. "Academic Building 01", "Yunus Khan Scholar Garden"
  campusLocation      String   @default("Ashulia Permanent Campus")
  totalFloorAreaSqM   Float    // Gross floor area in square meters for Energy Use Intensity (EUI)
  occupancyCapacity   Int      // Nominal student/staff capacity
  primaryFunction     String   // "Academic & Lecture Halls", "Computer & Research Labs", "Student Dormitory", "Central Library", "Administration"
  baselineDailyKwh    Float    // Expected normal daily baseline in kWh
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  metrics             EnergyMetric[]
  actionItems         ActionImprovement[]
}

// Configurable Energy Source (Grid, Solar PV, Backup Generator, Biogas Pilot)
// No assumed battery storage or automated electrical controls.
model EnergySource {
  id                 String   @id @default(uuid())
  code               String   @unique // "GRID_SUPPLY", "SOLAR_ROOFTOP", "CAMPUS_GENSET", "BIOGAS_PILOT"
  name               String   // "Configured National Grid Incomer", "Rooftop Solar PV Arrays", "Emergency Diesel Generator", "Biogas Pilot Plant"
  sourceType         String   // "GRID", "SOLAR", "GENERATOR", "BIOGAS"
  ratedCapacityKw    Float    // Maximum peak capacity rating in kW
  isRenewable        Boolean  @default(false)
  configuredProvider String   // Configurable utility/operator
  monitoringMethod   String   // "DIGITAL_SUBMETER", "INVERTER_PORTAL_EXPORT", "TECHNICAL_FUEL_LOGBOOK", "UNVERIFIED_PENDING_METERING"
  operationalStatus  String   @default("OPERATIONAL") // "OPERATIONAL", "UNVERIFIED_PILOT", "UNAVAILABLE"
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  metrics            EnergyMetric[]
  apiAdapters        ApiAdapterConfig[]
}

// Data Provenance & Ingestion Source Metadata
// Stamped on every data point to ensure 100% transparency between real and simulated data.
model DataSourceProvenance {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String   // e.g. "Inverter Cloud API Adapter", "Facility Monthly CSV Import", "Manual Logbook Entry", "Demonstration Simulation Engine"
  ingestionMethod  String   // "API_CONNECTOR", "CSV_EXCEL_IMPORT", "MANUAL_ENTRY", "DEMO_SIMULATION"
  isSimulated      Boolean  @default(false) // Strictly true for all demo/synthetic records
  confidenceRating Float    @default(1.0) // 0.0 to 1.0 (Simulation = 0.0, Verified Inverter API = 1.0)
  sourceDetails    String   // Description or connection endpoint
  description      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  metrics          EnergyMetric[]
  batches          IngestionBatch[]
}

// Batch Ingestion History & Validation Audits (Phase 2)
model IngestionBatch {
  id                    String   @id @default(uuid())
  filename              String
  fileType              String   // "CSV", "EXCEL", "MANUAL_BATCH", "API_SYNC"
  sourceType            String   // "CSV_IMPORT", "MANUAL_ENTRY", "REAL_API", "SIMULATED_DEMO"
  isSimulated           Boolean  @default(false)
  totalRows             Int
  successfulRows        Int
  rejectedRows          Int
  duplicateRows         Int
  validationErrorsJson  String?  // JSON string containing detailed validation error records
  summaryNotes          String?
  importedBy            String   // User email or "SYSTEM"
  createdAt             DateTime @default(now())

  provenanceId          String?
  provenance            DataSourceProvenance? @relation(fields: [provenanceId], references: [id], onDelete: SetNull)

  metrics               EnergyMetric[]

  @@index([createdAt])
  @@index([sourceType])
}

// Configurable External System API Adapters (Phase 2)
// Does NOT assume DIU API exists; fully parameterizable with status reporting.
model ApiAdapterConfig {
  id                    String   @id @default(uuid())
  name                  String   // e.g. "Campus Rooftop Inverter Telemetry Connector"
  adapterType           String   // "SOLAR_INVERTER", "GRID_METER", "GENSET_TELEMETRY", "BIOGAS_MONITOR"
  baseUrl               String
  authType              String   @default("NONE") // "API_KEY", "BEARER_TOKEN", "BASIC_AUTH", "NONE"
  authKeyMasked         String?
  pollingIntervalMins   Int      @default(60)
  status                String   @default("CONFIGURED_IDLE") // "CONFIGURED_IDLE", "ACTIVE_SYNCING", "CONNECTION_ERROR", "MOCK_SYNC_OK"
  lastSyncAt            DateTime?
  lastSyncStatus        String?
  lastSyncMessage       String?
  isSimulatedFallback   Boolean  @default(true)
  isEnabled             Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  targetEnergySourceId  String?
  targetEnergySource    EnergySource? @relation(fields: [targetEnergySourceId], references: [id], onDelete: SetNull)
}

// Energy Telemetry & Consumption Record
// Strictly technical: kWh, kW, litres of diesel, carbon offsets. ZERO financial data.
model EnergyMetric {
  id                    String   @id @default(uuid())
  timestamp             DateTime
  
  // Relations
  buildingId            String?
  building              Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  
  energySourceId        String?
  energySource          EnergySource? @relation(fields: [energySourceId], references: [id], onDelete: SetNull)
  
  provenanceId          String
  provenance            DataSourceProvenance @relation(fields: [provenanceId], references: [id], onDelete: Restrict)

  batchId               String?
  batch                 IngestionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  
  // Provenance flag copied for high-speed indexing & visual UI warnings
  isSimulated           Boolean  @default(false)

  // Technical Measurements - Grid & Consumption
  kwhConsumed           Float    @default(0.0) // Energy drawn from grid or consumed by building
  peakDemandKw          Float?   // Peak kW observed in period
  powerFactor           Float?   // Observed power factor (0.00 to 1.00)

  // Technical Measurements - Solar PV
  solarKwhGenerated     Float    @default(0.0) // Solar PV yield generated

  // Technical Measurements - Diesel Standby Generator
  dieselLitres          Float    @default(0.0) // Technical monitoring: Diesel fuel volume consumed by generator
  generatorRuntimeHours Float    @default(0.0) // Technical monitoring: Generator operating hours
  generatorKwhGenerated Float    @default(0.0) // Technical monitoring: Electricity generated by diesel generator

  // Technical Measurements - Biogas Pilot Plant
  biogasM3Consumed      Float    @default(0.0) // Volume of biogas consumed (cubic meters)
  biogasKwhGenerated    Float    @default(0.0) // Equivalent electricity generated from biogas

  // Calculated Emissions Metrics (Technical)
  carbonKgEmitted       Float    @default(0.0) // Calculated GHG emissions based on active emission factor
  carbonKgAvoided       Float    @default(0.0) // GHG emissions avoided via solar clean generation

  notes                 String?
  rawPayload            String?  // Audit copy of parsed source row
  createdAt             DateTime @default(now())

  @@index([timestamp])
  @@index([buildingId, timestamp])
  @@index([energySourceId, timestamp])
  @@index([isSimulated])
  @@index([batchId])
}

// Configurable Emission Factors, Methodologies & Assumptions
// Documents exact sources, conversion methodology, and explicit non-authoritative reference status.
model EmissionFactorConfig {
  id                  String   @id @default(uuid())
  factorKey           String   @unique // "GRID_ELECTRICITY_CO2", "DIESEL_FUEL_CO2"
  factorName          String   // "National Grid Electricity Carbon Intensity", "Diesel Stationary Combustion Emission Factor"
  unit                String   // "kg CO2e / kWh", "kg CO2e / Litre"
  value               Float    // e.g. 0.637 kg CO2e/kWh, 2.68 kg CO2e/Litre
  sourceDocumentation String   // Reference document / research paper citation
  methodology         String   // Exact mathematical / stoichiometric calculation methodology
  assumptions         String   // Key assumptions and boundary conditions
  isAuthoritative     Boolean  @default(false) // Stamped false to indicate reference default status
  isConfigurable      Boolean  @default(true)
  updatedBy           String?
  updatedAt           DateTime @updatedAt
}

// Action & Improvement Management
// Tracks detected issues, team assignments, baseline vs after consumption, and verified kWh savings.
model ActionImprovement {
  id                      String   @id @default(uuid())
  title                   String
  detectedIssue           String   // Problem description or AI-flagged anomaly
  recommendedAction       String   // Operational or maintenance intervention
  assignedTeam            String   // e.g. "Electrical Maintenance Unit", "HVAC Operations", "IT Infrastructure Support"
  assignedPersonnel       String?  // Specific lead engineer or technician
  deadline                DateTime?
  completionStatus        String   @default("IDENTIFIED") // "IDENTIFIED", "IN_PROGRESS", "COMPLETED", "VERIFIED", "CANCELLED"
  priority                String   @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  
  targetBuildingId        String?
  targetBuilding          Building? @relation(fields: [targetBuildingId], references: [id], onDelete: SetNull)
  
  beforeKwh               Float?   // Baseline measured consumption prior to intervention
  afterKwh                Float?   // Measured consumption following intervention
  verifiedKwhSavings      Float?   // Net verified kWh saved (beforeKwh - afterKwh)
  measurementPeriodDays   Int?     @default(30) // Measurement baseline period in days
  verificationMethod      String?  // e.g. "30-day comparative sub-meter logging", "Before-and-after audit measurement"
  verifiedCarbonSavingsKg Float?   // Verified GHG reduction in kg CO2e
  verifiedBy              String?  // Name or email of verifying engineer/auditor
  verifiedAt              DateTime?
  supportingEvidence      String?  // Empirical sensor logs or evidence description
  completionNotes         String?
  sdgAlignment            String?  @default("SDG_7") // "SDG_7", "SDG_9", "SDG_12", "SDG_13"
  
  reportedAt              DateTime @default(now())
  completedAt             DateTime?
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([completionStatus])
  @@index([priority])
  @@index([sdgAlignment])
}

// Sustainability & SDG Target Tracking (Phase 5)
model SustainabilityTarget {
  id                    String   @id @default(uuid())
  title                 String   // e.g. "Achieve 50% Clean Energy Self-Consumption by Q4 2026"
  sdgCategory           String   // "SDG_7", "SDG_9", "SDG_12", "SDG_13"
  targetPeriod          String   // e.g. "Academic Year 2026", "Q4 2026"
  baselineValue         Float    // Historical baseline value
  targetValue           Float    // Goal target value
  currentValue          Float    // Measured progress to date
  unit                  String   // "%", "kWh/m²", "kg CO2e", "kWh"
  status                String   @default("ON_TRACK") // "ON_TRACK", "AT_RISK", "ACHIEVED", "PENDING_REVIEW"
  calculationMethod     String   // Documented mathematical formulation
  remainingGap          Float    // targetValue - currentValue (or gap to goal)
  targetYear            Int      @default(2026)
  responsibleUnit       String   // e.g. "DIU Sustainability Committee & Facilities Division"
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([sdgCategory])
  @@index([status])
}

// Security & Data Lineage Audit Log
model AuditLog {
  id           String   @id @default(uuid())
  action       String   // e.g. "USER_LOGIN", "DATA_IMPORTED_CSV", "FACTOR_UPDATED", "ACTION_STATUS_CHANGED"
  performedBy  String   // User email or "SYSTEM"
  details      String
  timestamp    DateTime @default(now())
}

// ========================================================
// PHASE 4: AI ENERGY INTELLIGENCE & PREDICTIVE ANALYTICS
// ========================================================

// AI Model Execution Metadata & Provenance Audit (Phase 4)
model AiModelMetadata {
  id                    String   @id @default(uuid())
  modelName             String   // e.g. "Campus Diurnal Demand & Solar Forecaster"
  modelVersion          String   // e.g. "v1.2.0-statistical-hybrid"
  algorithmType         String   // "SEASONAL_DIURNAL_DECOMPOSITION_EWMA", "CLEAR_SKY_SOLAR_IRRADIANCE", "Z_SCORE_ANOMALY_DETECTOR"
  category              String   // "HISTORICAL_DATA_BASED", "STATISTICAL_ESTIMATE", "SIMULATED_DEMONSTRATION"
  dataSufficiencyNotice String   // Explains data sufficiency limitations and methodology transparently
  confidenceScore       Float    // Statistical confidence score (0.0 to 1.0)
  lastRunAt             DateTime @default(now())
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Energy Demand & Solar Generation Forecast Records (Phase 4)
model EnergyForecastRecord {
  id                String   @id @default(uuid())
  forecastType      String   // "CAMPUS_DEMAND_HOURLY", "CAMPUS_DEMAND_DAILY", "BUILDING_DEMAND_HOURLY", "SOLAR_GENERATION_HOURLY"
  targetTimestamp   DateTime
  forecastKwh       Float    // Projected electricity consumption or generation in kWh
  lowerBoundKwh     Float    // Statistical lower confidence boundary
  upperBoundKwh     Float    // Statistical upper confidence boundary
  actualKwh         Float?   // Historical actual value for backtesting accuracy comparison
  buildingId        String?
  buildingCode      String?  // e.g. "AB-01", "ALL_CAMPUS"
  category          String   // "HISTORICAL_DATA_BASED", "STATISTICAL_ESTIMATE", "SIMULATED_DEMONSTRATION"
  confidencePercent Float    // e.g. 90.0% confidence interval
  weatherFactorUsed Boolean  @default(false)
  weatherSource     String   @default("UNAVAILABLE_CLEAR_SKY_ESTIMATE") // Explicit notice when weather API is disconnected
  modelVersion      String   @default("v1.2.0-statistical-hybrid")
  createdAt         DateTime @default(now())

  @@index([forecastType, targetTimestamp])
  @@index([buildingCode, targetTimestamp])
  @@index([category])
}

// AI Anomaly Detection Event Log (Phase 4)
model EnergyAnomaly {
  id                 String   @id @default(uuid())
  timestamp          DateTime
  buildingId         String?
  buildingCode       String?  // e.g. "AB-01", "CAMPUS_WIDE", "SOLAR_ARRAY"
  anomalyType        String   // "UNUSUAL_NIGHTTIME_CONSUMPTION", "UNEXPECTED_CONSUMPTION_SPIKE", "ABNORMAL_BUILDING_EUI", "SUDDEN_GENERATION_DROP", "WEEKEND_OFFPEAK_ELEVATION", "METER_DATA_QUALITY_ANOMALY"
  severity           String   // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  observedValue      Float    // Actual measured metric (kWh or EUI)
  expectedBaseline   Float    // Expected normal baseline value
  deviationPercent   Float    // Percentage deviation from baseline
  zScore             Float?   // Number of standard deviations away from moving mean
  supportingEvidence String   // Empirical data points, timestamps, and conditions
  detectedRootCause  String   // Statistical or operational explanation
  suggestedAction    String   // Recommended investigation or operational intervention
  category           String   // "HISTORICAL_DATA_BASED", "STATISTICAL_ESTIMATE", "SIMULATED_DEMONSTRATION"
  isResolved         Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([timestamp])
  @@index([severity])
  @@index([anomalyType])
  @@index([buildingCode])
}

// AI Advisory & Actionable Recommendations (Phase 4)
model AiRecommendation {
  id                         String   @id @default(uuid())
  title                      String
  detectedIssue              String   // Root issue flagged by AI
  supportingEvidence         String   // Concrete sensor readings and variance metrics
  reasoning                  String   // Engineering/energy reasoning behind the recommendation
  suggestedAction            String   // Concrete operational steps
  priority                   String   // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  estimatedKwhSavingsWeekly  Float    // Estimated technical kWh savings (STRICTLY NON-FINANCIAL)
  outcomeDescription         String   // Explicitly labeled as an estimate
  category                   String   // "HISTORICAL_DATA_BASED", "STATISTICAL_ESTIMATE", "SIMULATED_DEMONSTRATION"
  targetBuildingId           String?
  targetBuildingCode         String?
  status                     String   @default("OPEN") // "OPEN", "CONVERTED_TO_ACTION", "DISMISSED"
  linkedActionId             String?  // Linked to ActionImprovement record when dispatched
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([priority])
  @@index([status])
  @@index([category])
}
