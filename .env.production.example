# DIU GreenGrid — Production Environment Variables Template
# ==============================================================================
# IMPORTANT: In production, configure these variables directly in your hosting
# provider's secure secret manager (Vercel, AWS Secrets Manager, Railway, Docker).
# NEVER commit populated .env files into source control repositories.
# ==============================================================================

# Node Environment
NODE_ENV="production"

# Production Database (PostgreSQL Recommended with SSL mode required)
DATABASE_URL="postgresql://diu_admin:SECURE_STRONG_DB_PASSWORD@ep-campus-energy.ap-southeast-1.aws.neon.tech/diu_greengrid?sslmode=require"

# JWT Encryption Secret (Must be a randomly generated 64+ char secret in production)
# Generate with: openssl rand -base64 48
JWT_SECRET="GENERATE_A_64_CHAR_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY"

# Application Metadata
NEXT_PUBLIC_APP_NAME="DIU GreenGrid"
NEXT_PUBLIC_APP_VERSION="1.0.0-prod"
NEXT_PUBLIC_CAMPUS="Daffodil International University - Ashulia Smart Campus"

# Security Parameters
MAX_FILE_UPLOAD_MB="15"
SESSION_EXPIRY_DAYS="7"
COOKIE_SECURE="true"
COOKIE_SAME_SITE="lax"
